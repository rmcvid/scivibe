{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "GCC 15.2.0 x86_64-w64-mingw32 (ucrt64)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "mingw-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "label": "Run sandbox",
            "type": "process",
            "command": "${workspaceFolder}/build/sandbox/sandbox",
            "windows": {
                "command": "${workspaceFolder}/build/sandbox/sandbox.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}/build/sandbox"
            },
            "dependsOn": "CMake Build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}