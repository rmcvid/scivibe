{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "GCC 15.2.0 x86_64-w64-mingw32 (ucrt64)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "mingw-debug",
                "--parallel"
            ],
            "dependsOn": "CMake Configure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "label": "Run sandbox",
            "type": "process",
            "command": "${workspaceFolder}/build/sandbox/sandbox",
            "windows": {
                "command": "${workspaceFolder}/build/sandbox/sandbox.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}/build/sandbox"
            },
            "dependsOn": "CMake Build",
            "problemMatcher": []
        }
    ]
}
